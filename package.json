{
  "name": "stockmaster",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "docker:up": "docker compose --profile apps up -d --build",
    "docker:down": "docker compose --profile apps down",
    "docker:logs": "docker compose --profile apps logs -f api web",
    "db:migrate": "pnpm --filter @stockmaster/api run migrate",
    "db:seed": "pnpm --filter @stockmaster/api run seed",
    "db:studio": "pnpm --filter @stockmaster/api run studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "yjs": "^13.6.27"
    }
  }
}
