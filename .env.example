# ─── Database (Postgres via docker-compose) ───────────────────────────────────
DATABASE_URL="postgresql://blockpress:blockpress@localhost:5433/blockpress?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Dev placeholders below are intentionally long but flagged "change-me"; the API
# refuses to boot in production while these (or any "change-me" value) are set.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── Mobile reader API (/v1) ──────────────────────────────────────────────────
# Shared secret the Expo app uses to HMAC-sign reader requests. Must be ≥32 chars.
# Rotate to a real secret in production (the API refuses to boot if it still says
# "change-me" while NODE_ENV=production).
MOBILE_APP_SECRET="dev-only-mobile-app-secret-change-me-0123456789abcdef"

# ─── API server ───────────────────────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN="http://localhost:5173"

# ─── Image uploads (stored on disk) ───────────────────────────────────────────
# Uploaded images are written under UPLOADS_DIR and served by the API at
# /uploads/*. PUBLIC_API_URL is the absolute base used to build <img src> links.
# UPLOADS_DIR defaults to <api cwd>/uploads if unset.
# UPLOADS_DIR="./uploads"
PUBLIC_API_URL="http://localhost:3001"

# ─── Web (Vite) ───────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001"
