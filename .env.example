# ─── Database (Postgres via docker-compose) ───────────────────────────────────
DATABASE_URL="postgresql://blockpress:blockpress@localhost:5433/blockpress?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Dev placeholders below are intentionally long but flagged "change-me"; the API
# refuses to boot in production while these (or any "change-me" value) are set.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── API server ───────────────────────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN="http://localhost:5173"

# ─── S3 / object storage (MinIO in dev, AWS S3 in prod) ───────────────────────
# In dev these point at the docker-compose MinIO. In prod, drop S3_ENDPOINT and
# S3_FORCE_PATH_STYLE and use real AWS credentials + region.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="blockpress"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Public base URL used to build <img src> links to uploaded objects.
S3_PUBLIC_URL="http://localhost:9000/blockpress"

# ─── Web (Vite) ───────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001"
