# ─── Blockpress draft-only MCP server ─────────────────────────────────────────
# Server config only. The server holds NO API key — each client presents its own
# draft-only key as `Authorization: Bearer <bp_key>` (see the README, §4), which the
# server forwards to the API. Connections with no key are rejected (401).

# Base URL of the running NestJS API (no trailing slash). The MCP server calls the
# existing REST endpoints over HTTP — it never touches Postgres directly.
BLOCKPRESS_API_URL="http://localhost:3001"

# Port the Streamable HTTP transport listens on. Clients connect to http://<host>:<port>/mcp.
MCP_HTTP_PORT="3002"

# (Production) comma-separated Host allowlist; setting it enables DNS-rebinding protection.
# MCP_ALLOWED_HOSTS="mcp.example.com"

# NOTE: the docker-compose `mcp` service sets BLOCKPRESS_API_URL (http://api:3001) and
# MCP_HTTP_PORT itself — it does NOT read this file. This file is for running standalone.
