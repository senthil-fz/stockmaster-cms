# ─── Blockpress draft-only MCP server ─────────────────────────────────────────
# Base URL of the running NestJS API (no trailing slash). The MCP server calls
# the existing REST endpoints over HTTP — it never touches Postgres directly.
BLOCKPRESS_API_URL="http://localhost:3001"

# The raw draft-only API key. Mint one in the web UI (API Keys) or via
#   curl -H 'Authorization: Bearer <jwt>' -H 'Content-Type: application/json' \
#        -d '{"name":"MCP draft agent","scopes":["works:write"]}' \
#        http://localhost:3001/api-keys
# It is shown exactly once. The MCP server sends it as `Authorization: ApiKey <key>`
# on every request — a works:write key can create/edit drafts but cannot publish or delete.
BLOCKPRESS_API_KEY="bp_replace-with-your-raw-draft-only-key"
