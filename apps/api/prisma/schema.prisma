// StockMaster — Prisma schema.
// Shared editorial workspace: no per-user row filtering. `createdById` is recorded
// for display ("author") only, never used to gate reads or writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  draft
  published
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarColor  String    @default("#7d8b6a")
  // null = active. When set, the account is suspended: login + token refresh are rejected.
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  books      Book[]
  articles   Article[]
  readEvents ReadEvent[]
  apiKeys    ApiKey[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  hashedKey   String    @unique
  prefix      String
  scopes      String[]  @default([])
  ownerUserId String
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime? // null = never expires
  createdAt   DateTime  @default(now())

  @@index([ownerUserId])
}

// A BOOK — a multi-chapter work with a Chapter → Page tree. (Formerly `Work`; a Work was
// always a book once articles became their own single-page type.)
model Book {
  id          String        @id @default(cuid())
  slug        String?       @unique // nullable-unique: backfilled for existing books, set on create
  title       String
  subtitle    String        @default("")
  author      String        @default("")
  year        String        @default("")
  coverTone   String        @default("default")
  coverUrl    String?
  buyLink     String?
  status      PublishStatus @default(draft)
  tags        String[]      @default([])
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chapters   Chapter[]
  readEvents ReadEvent[]

  @@index([status])
}

// An ARTICLE — a single page of content. No chapters/pages: `content` holds one TipTap doc.
// Native uuid PK + unique slug (additive ID strategy; books keep their cuid PKs).
model Article {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  title       String
  subtitle    String        @default("")
  author      String        @default("")
  year        String        @default("")
  coverTone   String        @default("default")
  coverUrl    String?
  tags        String[]      @default([])
  content     Json
  wordCount   Int           @default(0)
  status      PublishStatus @default(draft)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]

  @@index([bookId, order])
}

model Page {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String        @default("")
  content   Json
  status    PublishStatus @default(draft)
  order     Int           @default(0)
  wordCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([chapterId, order])
}

// Append-only read-activity log. One row per tracked read (a page read, or a book open),
// written by ReadTrackingInterceptor. All book read-stats (popularity, completion, unique
// readers, trends) are queries over this table. `client` is the X-Client tag (e.g.
// "mobile-ios" / "web"); `userId` is the authenticated reader. Never updated.
model ReadEvent {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageId    String? // null for a book_open event
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    String   @default("unknown")
  kind      String // 'page_read' | 'book_open'
  createdAt DateTime @default(now())

  // No standalone @@index([client]): a default-collation btree can't serve the
  // `client LIKE 'prefix%'` filter, and on this append-heavy log it would only add
  // write cost. The client filter rides along the bookId/createdAt-scoped scans.
  @@index([bookId, createdAt])
  @@index([bookId, userId])
  @@index([createdAt])
}
