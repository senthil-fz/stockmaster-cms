// StockMaster — Prisma schema.
// Shared editorial workspace: no per-user row filtering. `createdById` is recorded
// for display ("author") only, never used to gate reads or writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  draft
  published
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarColor  String    @default("#7d8b6a")
  // null = active. When set, the account is suspended: login + token refresh are rejected.
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  books           Book[]
  articles        Article[]
  readEvents      ReadEvent[]
  apiKeys         ApiKey[]
  bookVersions    BookVersion[]
  articleVersions ArticleVersion[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  hashedKey   String    @unique
  prefix      String
  scopes      String[]  @default([])
  ownerUserId String
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime? // null = never expires
  createdAt   DateTime  @default(now())

  @@index([ownerUserId])
}

// A BOOK — a multi-chapter work with a Chapter → Page tree. (Formerly `Work`; a Work was
// always a book once articles became their own single-page type.)
model Book {
  id          String        @id @default(cuid())
  slug        String?       @unique // nullable-unique: backfilled for existing books, set on create
  title       String
  subtitle    String        @default("")
  author      String        @default("")
  year        String        @default("")
  coverTone   String        @default("default")
  coverUrl    String?
  buyLink     String?
  tags        String[]      @default([])
  // Pointer to the one live version (null = not public). Sole source of truth for
  // "publicly visible"; `status` is derived from it in responses, never stored.
  publishedVersionId String?      @unique
  publishedVersion   BookVersion? @relation("BookPublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  // The draft tree has edits not yet captured in a published version.
  draftDirty         Boolean      @default(false)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chapters   Chapter[]
  readEvents ReadEvent[]
  versions   BookVersion[] @relation("BookVersions")
}

// An immutable JSON snapshot of a Book at publish time. Never updated or deleted by
// editor flows; `restore` only repoints Book.publishedVersionId. The snapshot is
// self-contained (see "Snapshot schema" in the versioning design) and carries its own
// `schemaVersion` so it stays readable independent of the live tree.
model BookVersion {
  id            String   @id @default(cuid())
  bookId        String
  book          Book     @relation("BookVersions", fields: [bookId], references: [id], onDelete: Cascade)
  versionNumber Int // monotonic per book, starts at 1
  snapshot      Json // self-contained reading structure (book metadata + chapters → pages)
  schemaVersion Int      @default(1) // snapshot envelope version
  wordCount     Int      @default(0)
  pageCount     Int      @default(0)
  note          String? // optional editor note ("fixed typos in ch.3")
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  // Back-reference for the one-to-one published pointer (Book.publishedVersion).
  publishedFor Book? @relation("BookPublished")

  @@unique([bookId, versionNumber])
  @@index([bookId, createdAt])
}

// An ARTICLE — a single page of content. No chapters/pages: `content` holds one TipTap doc.
// Native uuid PK + unique slug (additive ID strategy; books keep their cuid PKs).
model Article {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  title       String
  subtitle    String        @default("")
  author      String        @default("")
  year        String        @default("")
  coverTone   String        @default("default")
  coverUrl    String?
  tags        String[]      @default([])
  content     Json
  wordCount   Int           @default(0)
  // Pointer to the one live version (null = not public). Sole source of truth for
  // "publicly visible"; `status` is derived from it in responses, never stored.
  publishedVersionId String?         @unique
  publishedVersion   ArticleVersion? @relation("ArticlePublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  // The draft has edits not yet captured in a published version.
  draftDirty         Boolean         @default(false)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions ArticleVersion[] @relation("ArticleVersions")
}

// An immutable JSON snapshot of an Article at publish time. Analogue of BookVersion
// (no pageCount; the snapshot holds the single TipTap doc). Never mutated by editor
// flows; `restore` only repoints Article.publishedVersionId.
model ArticleVersion {
  id            String   @id @default(cuid())
  articleId     String   @db.Uuid
  article       Article  @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber Int // monotonic per article, starts at 1
  snapshot      Json // self-contained (article metadata + content + wordCount)
  schemaVersion Int      @default(1) // snapshot envelope version
  wordCount     Int      @default(0)
  note          String? // optional editor note
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  // Back-reference for the one-to-one published pointer (Article.publishedVersion).
  publishedFor Article? @relation("ArticlePublished")

  @@unique([articleId, versionNumber])
  @@index([articleId, createdAt])
}

model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]

  @@index([bookId, order])
}

model Page {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String        @default("")
  content   Json
  status    PublishStatus @default(draft)
  order     Int           @default(0)
  wordCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([chapterId, order])
}

// Append-only read-activity log. One row per tracked read (a page read, or a book open),
// written by ReadTrackingInterceptor. All book read-stats (popularity, completion, unique
// readers, trends) are queries over this table. `client` is the X-Client tag (e.g.
// "mobile-ios" / "web"); `userId` is the authenticated reader. Never updated.
model ReadEvent {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageId    String? // null for a book_open event
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    String   @default("unknown")
  kind      String // 'page_read' | 'book_open'
  createdAt DateTime @default(now())

  // No standalone @@index([client]): a default-collation btree can't serve the
  // `client LIKE 'prefix%'` filter, and on this append-heavy log it would only add
  // write cost. The client filter rides along the bookId/createdAt-scoped scans.
  @@index([bookId, createdAt])
  @@index([bookId, userId])
  @@index([createdAt])
}
