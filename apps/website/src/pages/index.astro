---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import iconImg from '../assets/icon.png';
import calculatorsImg from '../assets/1-calculators.png';
import aboutScreenImg from '../assets/3-about.png';
import masteringOptionsImg from '../assets/mastering-options.jpg';
import commonMansVoyageImg from '../assets/common-mans-voyage.jpg';
import behavioralInvestorImg from '../assets/behavioral-investor.jpg';
import nagarajImg from '../assets/Nagaraj.png';

// <picture> set to display:contents so the optimized <img> keeps the exact
// layout/classes of the original tag while the browser still picks avif/webp.
const PICTURE = { class: 'contents' };

const PLAY_URL =
  'https://play.google.com/store/apps/details?id=com.sharemarketclass.stockmaster';

// Public API base for the live Pulse feed (overridable via PUBLIC_API_URL at build).
const apiBase = import.meta.env.PUBLIC_API_URL ?? 'https://api.stockmasternagaraj.com';
---

<Layout>
  <div class="bg-surface overflow-x-hidden">
    <!-- ============ NAV ============ -->
    <header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-md border-b border-line">
      <nav
        class="mx-auto max-w-[1200px] px-8 py-3.5 flex items-center justify-between gap-6 max-[560px]:px-5"
      >
        <div class="flex items-center gap-[11px]">
          <Picture
            src={iconImg}
            formats={['avif', 'webp']}
            pictureAttributes={PICTURE}
            alt="Stock Master"
            widths={[34, 68]}
            sizes="34px"
            class="w-[34px] h-[34px] rounded-[10px] shrink-0"
          />
          <span class="font-extrabold text-[19px] tracking-[-0.02em]">Stock Master</span>
        </div>
        <div
          class="flex items-center gap-[30px] text-[15px] font-medium text-ink-soft max-[900px]:hidden"
        >
          <a href="#features" class="no-underline">Features</a>
          <a href="#books" class="no-underline">Books</a>
          <a href="#pulse" class="no-underline">Pulse</a>
          <a href="#about" class="no-underline">About</a>
        </div>
        <a
          href="#download"
          class="inline-flex items-center gap-2 bg-brand text-white px-5 py-2.5 rounded-[11px] text-sm font-bold no-underline shadow-[0_6px_16px_-6px_rgba(47,107,255,0.6)]"
          >Download App</a
        >
      </nav>
    </header>

    <!-- ============ HERO ============ -->
    <section
      class="relative mx-auto max-w-[1200px] px-8 pt-[60px] pb-9 grid grid-cols-[1.05fr_0.95fr] gap-12 items-center max-[900px]:grid-cols-1 max-[900px]:pt-10 max-[560px]:px-5"
    >
      <div
        class="absolute -top-[60px] -right-[140px] w-[580px] h-[580px] rounded-full bg-[radial-gradient(circle_at_50%_50%,rgba(47,107,255,0.12),rgba(47,107,255,0)_70%)] z-0"
      >
      </div>
      <div class="relative z-10">
        <div
          class="inline-flex items-center gap-[9px] bg-white border border-line px-[14px] py-[7px] rounded-full text-[13px] font-semibold text-brand-strong mb-[26px] shadow-[0_2px_8px_-4px_rgba(20,21,26,0.1)]"
        >
          <span class="text-gold text-sm">★</span>
          Built by record-holder Nagaraj Balasubramaniam
        </div>
        <h1
          class="font-extrabold text-[62px] leading-[1.02] tracking-[-0.04em] text-ink text-balance max-[900px]:text-[44px] max-[560px]:text-[36px]"
        >
          Master the markets, all in one app.
        </h1>
        <p class="text-lg leading-[1.6] text-ink-soft mt-[22px] max-w-[500px]">
          Pro trading calculators, a library of investing books you can read in-app, and Pulse —
          daily market insight. Built by Nagaraj Balasubramaniam, IIM Lucknow alumnus and
          record-holding market educator.
        </p>
        <div class="flex flex-wrap gap-[14px] mt-8">
          <span class="relative inline-flex cursor-default" role="img" aria-label="On the App Store — coming soon">
            <img src="/uploads/app-store-badge.png" alt="Download on the App Store" class="h-[54px] w-auto opacity-[0.55]" />
            <span
              class="absolute -top-[9px] -right-[7px] bg-brand text-white text-[10px] font-extrabold tracking-[0.06em] uppercase px-[9px] py-[3px] rounded-full whitespace-nowrap shadow-[0_4px_12px_-3px_rgba(47,107,255,0.65)]"
              >Coming soon</span
            >
          </span>
          <a href={PLAY_URL} target="_blank" rel="noopener" aria-label="Get it on Google Play" class="inline-flex">
            <img src="/uploads/google-play-badge.png" alt="Get it on Google Play" class="h-[54px] w-auto" />
          </a>
        </div>
        <div class="flex items-center gap-2.5 mt-6 text-sm text-ink-soft">
          <span class="text-gold text-[15px] tracking-[1px]">★★★★★</span>
          <span>Free on Android — no ads, no clutter. iOS coming soon.</span>
        </div>
      </div>
      <div class="relative z-10 flex justify-center">
        <div
          class="w-[312px] rounded-[46px] bg-ink p-[11px] shadow-[0_44px_90px_-34px_rgba(31,50,90,0.55)]"
        >
          <Picture
            src={calculatorsImg}
            formats={['avif', 'webp']}
            pictureAttributes={PICTURE}
            alt="Trading calculators screen"
            widths={[300, 600]}
            sizes="300px"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-[36px]"
          />
        </div>
      </div>
    </section>

    <!-- ============ FEATURE TRIO ============ -->
    <section id="features" class="mx-auto max-w-[1200px] px-8 pt-14 pb-8 max-[560px]:px-5">
      <div class="text-center max-w-[640px] mx-auto mb-11">
        <div class="text-[13px] font-bold tracking-[0.12em] uppercase text-brand mb-[14px]">
          What's inside
        </div>
        <h2 class="font-extrabold text-[38px] leading-[1.08] tracking-[-0.03em]">
          Three tools that compound your edge
        </h2>
      </div>
      <div class="grid grid-cols-3 gap-[22px] items-start max-[700px]:grid-cols-1">
        <div
          class="bg-white border border-line rounded-[20px] p-[30px] shadow-[0_2px_10px_-6px_rgba(20,21,26,0.08)]"
        >
          <div class="w-12 h-12 rounded-[13px] bg-tint flex items-center justify-center mb-5">
            <div class="w-5 h-5 border-[2.5px] border-brand rounded-[5px]"></div>
          </div>
          <h3 class="text-xl font-bold tracking-[-0.01em] mb-2">Trading calculators</h3>
          <p class="text-[15px] leading-[1.55] text-ink-soft">
            Run the numbers before you place a trade — pivots, ranges and investment math, all built
            in. Tap a value, get an answer.
          </p>
        </div>
        <div
          class="bg-white border border-line rounded-[20px] p-[30px] shadow-[0_2px_10px_-6px_rgba(20,21,26,0.08)]"
        >
          <div class="w-12 h-12 rounded-[13px] bg-tint flex items-center justify-center mb-5">
            <div class="w-4 h-5 border-[2.5px] border-l-[5px] border-brand rounded-[2px]"></div>
          </div>
          <h3 class="text-xl font-bold tracking-[-0.01em] mb-2">Bestselling books</h3>
          <p class="text-[15px] leading-[1.55] text-ink-soft">
            Nagaraj's bestselling titles on options, behaviour and the markets — buy the paperback
            on Amazon in a tap.
          </p>
        </div>
        <div
          class="bg-white border border-line rounded-[20px] p-[30px] shadow-[0_2px_10px_-6px_rgba(20,21,26,0.08)]"
        >
          <div class="w-12 h-12 rounded-[13px] bg-tint flex items-center justify-center mb-5">
            <div
              class="w-5 h-5 rounded-full border-[2.5px] border-brand border-t-transparent rotate-[-45deg]"
            >
            </div>
          </div>
          <h3 class="text-xl font-bold tracking-[-0.01em] mb-2">Pulse insights</h3>
          <p class="text-[15px] leading-[1.55] text-ink-soft">
            The market decoded daily — concise, jargon-free articles written for everyday investors.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ BOOKS ============ -->
    <section id="books" class="mx-auto max-w-[1200px] px-8 py-[72px] max-[560px]:px-5">
      <div class="text-center max-w-[640px] mx-auto mb-12">
        <div class="text-[13px] font-bold tracking-[0.12em] uppercase text-brand mb-[14px]">
          The library
        </div>
        <h2 class="font-extrabold text-[40px] leading-[1.06] tracking-[-0.03em] mb-[14px]">
          Books by Nagaraj
        </h2>
        <p class="text-[17px] leading-[1.6] text-ink-soft">
          Options trading, the markets and the psychology of investing — read them in the app, or
          buy the paperback on Amazon.
        </p>
      </div>
      <div
        class="bg-white border border-line rounded-[28px] px-11 pt-[60px] pb-[52px] shadow-[0_6px_30px_-16px_rgba(20,21,26,0.16)]"
      >
        <div class="grid grid-cols-3 gap-11 items-start max-[700px]:grid-cols-1 max-[700px]:gap-[52px]">
          <!-- Mastering Options -->
          <a
            class="group flex flex-col items-center text-center no-underline text-inherit"
            href="https://www.amazon.in/Mastering-Options-Trading-Indian-Market/dp/9359890146"
            target="_blank"
            rel="noopener"
          >
            <div class="w-full flex justify-center">
              <Picture
                src={masteringOptionsImg}
                formats={['avif', 'webp']}
                pictureAttributes={PICTURE}
                alt="Mastering Options Trading in the Indian Stock Market"
                widths={[240, 480]}
                sizes="240px"
                class="w-full max-w-[240px] aspect-[2/3] object-cover rounded-lg shadow-[0_26px_46px_-22px_rgba(20,21,26,0.5)]"
              />
            </div>
            <div class="mt-[30px] text-[11px] font-bold tracking-[0.14em] uppercase text-brand">
              Options trading
            </div>
            <h3
              class="mt-2.5 text-base font-bold leading-[1.34] tracking-[-0.01em] text-ink min-h-[64px] max-[900px]:min-h-0"
            >
              Mastering Options Trading in the Indian Stock Market
            </h3>
            <div class="mt-2 text-[13px] text-muted">Paperback · 2023</div>
            <span
              class="mt-5 inline-flex items-center gap-[7px] border-[1.5px] border-line text-brand-strong px-[18px] py-[9px] rounded-[10px] text-[13px] font-bold group-hover:border-brand group-hover:bg-[#f2f6ff]"
              >Buy on Amazon →</span
            >
          </a>

          <!-- A Common Man's Voyage -->
          <a
            class="group flex flex-col items-center text-center no-underline text-inherit"
            href="https://www.amazon.in/Comman-Mans-Voyage-STOCK-MARKET/dp/9358476141"
            target="_blank"
            rel="noopener"
          >
            <div class="w-full flex justify-center">
              <Picture
                src={commonMansVoyageImg}
                formats={['avif', 'webp']}
                pictureAttributes={PICTURE}
                alt="A Common Man's Voyage in the Stock Market"
                widths={[240, 480]}
                sizes="240px"
                class="w-full max-w-[240px] aspect-[2/3] object-cover rounded-lg shadow-[0_26px_46px_-22px_rgba(20,21,26,0.5)]"
              />
            </div>
            <div class="mt-[30px] text-[11px] font-bold tracking-[0.14em] uppercase text-brand">
              Stock market journey
            </div>
            <h3
              class="mt-2.5 text-base font-bold leading-[1.34] tracking-[-0.01em] text-ink min-h-[64px] max-[900px]:min-h-0"
            >
              A Common Man's Voyage in the Stock Market
            </h3>
            <div class="mt-2 text-[13px] text-muted">Paperback · 2024</div>
            <span
              class="mt-5 inline-flex items-center gap-[7px] border-[1.5px] border-line text-brand-strong px-[18px] py-[9px] rounded-[10px] text-[13px] font-bold group-hover:border-brand group-hover:bg-[#f2f6ff]"
              >Buy on Amazon →</span
            >
          </a>

          <!-- The Behavioural Investor -->
          <a
            class="group flex flex-col items-center text-center no-underline text-inherit"
            href="https://www.amazon.in/Behavioral-Investor-People-Financial-Choices/dp/9358479183"
            target="_blank"
            rel="noopener"
          >
            <div class="w-full flex justify-center">
              <Picture
                src={behavioralInvestorImg}
                formats={['avif', 'webp']}
                pictureAttributes={PICTURE}
                alt="The Behavioural Investor"
                widths={[240, 480]}
                sizes="240px"
                class="w-full max-w-[240px] aspect-[2/3] object-cover rounded-lg shadow-[0_26px_46px_-22px_rgba(20,21,26,0.5)]"
              />
            </div>
            <div class="mt-[30px] text-[11px] font-bold tracking-[0.14em] uppercase text-brand">
              Investor psychology
            </div>
            <h3
              class="mt-2.5 text-base font-bold leading-[1.34] tracking-[-0.01em] text-ink min-h-[64px] max-[900px]:min-h-0"
            >
              The Behavioural Investor
            </h3>
            <div class="mt-2 text-[13px] text-muted">Paperback · 2025</div>
            <span
              class="mt-5 inline-flex items-center gap-[7px] border-[1.5px] border-line text-brand-strong px-[18px] py-[9px] rounded-[10px] text-[13px] font-bold group-hover:border-brand group-hover:bg-[#f2f6ff]"
              >Buy on Amazon →</span
            >
          </a>
        </div>
      </div>
    </section>

    <!-- ============ PULSE ============ -->
    <section id="pulse" class="bg-white border-y border-line">
      <div class="mx-auto max-w-[1200px] px-8 py-16 max-[560px]:px-5">
        <div class="flex items-end justify-between gap-6 mb-9 flex-wrap">
          <div class="max-w-[560px]">
            <div class="text-[13px] font-bold tracking-[0.12em] uppercase text-brand mb-[14px]">
              Pulse
            </div>
            <h2 class="font-extrabold text-[38px] leading-[1.08] tracking-[-0.03em]">
              The market, decoded daily
            </h2>
          </div>
          <a
            href="#download"
            class="inline-flex items-center gap-2 text-brand-strong font-bold text-[15px] no-underline border-b-2 border-brand pb-[3px]"
            >Read in the app →</a
          >
        </div>
        <!-- Flex-wrap (not a fixed 3-col grid) so the row stays balanced no matter how
             many articles are published: 1 centers, 2 pair up, 3 fill, 6 wrap to two rows.
             JS swaps a single published article to a wide "featured" card (see below). -->
        <div id="pulse-grid" class="flex flex-wrap justify-center gap-6">
          <!-- Skeletons shown until the live feed loads; replaced by JS (or the whole
               section is hidden if there are no published articles / the API is down). -->
          <article
            class="flex-1 min-w-[280px] max-w-[372px] bg-white border border-line rounded-[20px] overflow-hidden animate-pulse"
          >
            <div class="aspect-[16/10] bg-[linear-gradient(135deg,#2F6BFF,#1E50D8)]"></div>
            <div class="p-6">
              <div class="h-[18px] w-3/4 rounded bg-line"></div>
              <div class="h-[18px] w-1/2 rounded bg-line mt-2.5"></div>
              <div class="h-[13px] w-1/3 rounded bg-line mt-5"></div>
            </div>
          </article>
          <article
            class="flex-1 min-w-[280px] max-w-[372px] bg-white border border-line rounded-[20px] overflow-hidden animate-pulse max-[700px]:hidden"
          >
            <div class="aspect-[16/10] bg-[linear-gradient(135deg,#14151A,#2A3550)]"></div>
            <div class="p-6">
              <div class="h-[18px] w-3/4 rounded bg-line"></div>
              <div class="h-[18px] w-1/2 rounded bg-line mt-2.5"></div>
              <div class="h-[13px] w-1/3 rounded bg-line mt-5"></div>
            </div>
          </article>
          <article
            class="flex-1 min-w-[280px] max-w-[372px] bg-white border border-line rounded-[20px] overflow-hidden animate-pulse max-[1000px]:hidden"
          >
            <div class="aspect-[16/10] bg-[linear-gradient(135deg,#4C82FF,#6FA8FF)]"></div>
            <div class="p-6">
              <div class="h-[18px] w-3/4 rounded bg-line"></div>
              <div class="h-[18px] w-1/2 rounded bg-line mt-2.5"></div>
              <div class="h-[13px] w-1/3 rounded bg-line mt-5"></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <script is:inline define:vars={{ apiBase }}>
      // Pulse feed: load published articles from the public API at runtime so newly
      // published pieces appear without a site rebuild. Missing covers fall back to a
      // brand gradient; an empty feed or an API error hides the whole section.
      (function () {
        const section = document.getElementById('pulse');
        const grid = document.getElementById('pulse-grid');
        if (!section || !grid) return;

        const GRADS = [
          'linear-gradient(135deg,#2F6BFF,#1E50D8)',
          'linear-gradient(135deg,#14151A,#2A3550)',
          'linear-gradient(135deg,#4C82FF,#6FA8FF)',
        ];
        const esc = (s) =>
          String(s ?? '').replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
          );
        const fmtDate = (iso) => {
          const d = new Date(iso);
          return isNaN(d.getTime())
            ? ''
            : d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        };

        // Cover image, or a brand-gradient block carrying the wordmark when none exists.
        const coverBlock = (a, i) =>
          a.coverUrl
            ? '<img src="' +
              esc(a.coverUrl) +
              '" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />'
            : '<div class="absolute inset-0 flex items-center justify-center" style="background:' +
              GRADS[i % GRADS.length] +
              '"><span class="text-white/90 font-extrabold tracking-[-0.02em] text-[19px]">Stock Master</span></div>';

        // Eyebrow over the title: category tag and/or read time, dot-separated. `lead` lets the
        // featured card prepend "Latest". Empty parts are dropped so we never render a lone dot.
        const eyebrow = (a, lead) => {
          const parts = [
            lead,
            a.tag ? esc(a.tag) : '',
            a.readingMinutes ? a.readingMinutes + ' min read' : '',
          ].filter(Boolean);
          return parts.length
            ? '<div class="text-[12px] font-bold tracking-[0.1em] uppercase text-brand mb-3">' +
                parts.join(' &middot; ') +
                '</div>'
            : '';
        };

        // Excerpt paragraph (subtitle or body teaser). `lines` clamps it so card heights stay even.
        const excerpt = (a, lines) =>
          a.excerpt
            ? '<p class="mt-2.5 text-[14.5px] leading-[1.55] text-ink-soft ' +
              lines +
              '">' +
              esc(a.excerpt) +
              '</p>'
            : '';

        // Byline footer: author (left) and date (right), split by a hairline. `push` pins it to
        // the card bottom so a row of vertical cards lines up; the featured card omits it.
        const metaRow = (a, push) =>
          '<div class="' +
          (push ? 'mt-auto ' : '') +
          'pt-5 mt-5 flex items-center justify-between gap-3 border-t border-line/80 text-[13px]">' +
          (a.author
            ? '<span class="font-semibold text-ink truncate">' + esc(a.author) + '</span>'
            : '<span></span>') +
          '<span class="text-muted shrink-0">' +
          fmtDate(a.publishedAt) +
          '</span></div>';

        // Standard vertical article card (used when 2+ articles are published).
        const vCard = (a, i) =>
          '<article class="group flex flex-col flex-1 min-w-[280px] max-w-[372px] bg-white border border-line rounded-[20px] overflow-hidden transition-all duration-300 hover:border-brand/40 hover:shadow-[0_22px_44px_-26px_rgba(20,21,26,0.4)]">' +
          '<div class="relative aspect-[16/10] overflow-hidden">' +
          coverBlock(a, i) +
          '</div>' +
          '<div class="flex flex-col flex-1 p-6">' +
          eyebrow(a, '') +
          '<h3 class="text-[19px] font-bold leading-[1.3] tracking-[-0.01em] text-ink line-clamp-2">' +
          esc(a.title) +
          '</h3>' +
          excerpt(a, 'line-clamp-2') +
          metaRow(a, true) +
          '</div></article>';

        // Full-width featured card for the lone-article case: it spans the whole content
        // column (aligned to the section header), the cover fills its entire half, and the
        // text block is vertically centered — so no whitespace is left floating around it.
        const fCard = (a) =>
          '<article class="group grid grid-cols-2 max-[700px]:grid-cols-1 w-full bg-white border border-line rounded-[24px] overflow-hidden transition-all duration-300 hover:border-brand/40 hover:shadow-[0_28px_56px_-30px_rgba(20,21,26,0.45)]">' +
          '<div class="relative min-h-[340px] max-[700px]:min-h-0 max-[700px]:aspect-[16/9] overflow-hidden">' +
          coverBlock(a, 0) +
          '</div>' +
          '<div class="flex flex-col justify-center p-11 max-[700px]:p-7">' +
          eyebrow(a, 'Latest') +
          '<h3 class="text-[30px] max-[700px]:text-[23px] font-extrabold leading-[1.16] tracking-[-0.02em] text-ink">' +
          esc(a.title) +
          '</h3>' +
          excerpt(a, 'line-clamp-3') +
          metaRow(a, false) +
          '</div></article>';

        fetch(apiBase + '/v1/public/articles', { headers: { accept: 'application/json' } })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((items) => {
            if (!Array.isArray(items) || items.length === 0) {
              section.style.display = 'none';
              return;
            }
            const list = items.slice(0, 6);
            grid.innerHTML =
              list.length === 1 ? fCard(list[0]) : list.map((a, i) => vCard(a, i)).join('');
          })
          .catch(() => {
            section.style.display = 'none';
          });
      })();
    </script>

    <!-- ============ ABOUT / RECORD HOLDER ============ -->
    <section id="about" class="mx-auto max-w-[1200px] px-8 py-20 max-[560px]:px-5">
      <div
        class="bg-navy rounded-[28px] p-11 grid grid-cols-[0.8fr_1.2fr] gap-11 items-center overflow-hidden relative max-[900px]:grid-cols-1"
      >
        <div
          class="absolute -bottom-[130px] -right-[90px] w-[380px] h-[380px] rounded-full bg-[rgba(111,168,255,0.12)]"
        >
        </div>
        <Picture
          src={nagarajImg}
          formats={['avif', 'webp']}
          pictureAttributes={PICTURE}
          alt="Nagaraj Balasubramaniam"
          widths={[400, 560, 960]}
          sizes="(max-width: 900px) 92vw, 460px"
          class="w-full rounded-[20px] relative z-10 shadow-[0_30px_60px_-25px_rgba(0,0,0,0.5)] object-cover"
        />
        <div class="relative z-10 text-[#E8EDF6]">
          <div
            class="inline-flex items-center gap-2 bg-[rgba(215,162,46,0.16)] border border-[rgba(215,162,46,0.5)] text-[#EFC368] px-[14px] py-[7px] rounded-full text-[13px] font-bold mb-5"
          >
            <span>★</span> National &amp; Guinness Record Holder
          </div>
          <h2 class="font-extrabold text-[38px] leading-[1.06] tracking-[-0.03em] mb-4">
            Meet Nagaraj Balasubramaniam
          </h2>
