---
// Shared site footer — dark, minimal.
import { Picture } from 'astro:assets';
import iconImg from '../assets/icon.png';
---

<footer class="bg-navy text-[#A9B6CE]">
  <div
    class="mx-auto max-w-[1200px] px-8 py-12 flex items-center justify-between gap-6 flex-wrap max-[560px]:px-5 max-[560px]:flex-col max-[560px]:gap-6 max-[560px]:text-center"
  >
    <a href="/" class="flex items-center gap-[11px] no-underline">
      <Picture
        src={iconImg}
        formats={['avif', 'webp']}
        pictureAttributes={{ class: 'contents' }}
        alt="Stock Master"
        widths={[34, 68]}
        sizes="34px"
        class="w-[34px] h-[34px] rounded-[10px] shrink-0"
      />
      <span class="font-extrabold text-[19px] tracking-[-0.02em] text-white">Stock Master</span>
    </a>
    <div
      class="flex items-center gap-7 text-sm font-medium max-[560px]:flex-col max-[560px]:gap-3"
    >
      <a
        href="/privacy"
        class="text-[#A9B6CE] no-underline hover:text-white transition-colors">Privacy Policy</a
      >
      <span class="text-[#A9B6CE]">
        Designed by <a
          href="https://frenzo.io"
          target="_blank"
          rel="noopener"
          class="text-brand font-semibold no-underline hover:opacity-80 transition-opacity">Frenzo</a
        >
      </span>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div
      class="mx-auto max-w-[1200px] px-8 py-5 flex justify-between items-center flex-wrap gap-3 text-[13px] text-[#74829C] max-[560px]:px-5 max-[560px]:justify-center max-[560px]:text-center"
    >
      <span>© 2026 Stock Master. All rights reserved.</span>
      <span>Investing involves risk. Not financial advice.</span>
    </div>
  </div>
</footer>
